# ==============================================================================
# RepoGraph Environment Configuration
# Tagline: See how your code works. Explore how everything connects.
# ==============================================================================

# ------------------------------------------------------------------------------
# Google GenAI / Hosted Gemma 4 Configuration
# ------------------------------------------------------------------------------
# Get your API key from Google AI Studio: https://aistudio.google.com/
# RepoGraph functions with full static analysis and 3D visualization even without a key.
# When provided, hosted Gemma 4 explains components, execution paths, and impact.
GEMINI_API_KEY=

# Preferred official model identifier: gemma-4-26b-a4b-it
# Fallbacks: gemma-2-27b-it, gemma-2-9b-it, gemini-2.5-flash
GEMMA_MODEL=gemma-4-26b-a4b-it

# ------------------------------------------------------------------------------
# GitHub Integration (Optional)
# ------------------------------------------------------------------------------
# Optional token to increase GitHub API rate limits for public repository ingestion.
GITHUB_TOKEN=

# ------------------------------------------------------------------------------
# Networking & Security
# ------------------------------------------------------------------------------
FRONTEND_ORIGIN=http://localhost:5173

# Archive and file limits for static analysis
MAX_REPO_ZIP_SIZE_BYTES=52428800    # 50 MB
MAX_EXTRACTED_SIZE_BYTES=125829120  # 120 MB
MAX_FILE_COUNT=3500                 # max 3500 files
MAX_SINGLE_FILE_SIZE_BYTES=2097152  # 2 MB per file
REQUEST_TIMEOUT_SECONDS=30.0
AI_TIMEOUT_SECONDS=45.0
